{
  "name": "volunteer-manager-animecon",
  "version": "5.0.0",
  "description": "AnimeCon Volunteer Manager",
  "scripts": {
    "sync-db": "node ts-sql.build.mjs",
    "build": "next build",
    "build-with-bundle-analyzer": "cross-env ANALYZE=true next build",
    "circular": "npx madge --circular --extensions ts,tsx .",
    "serve": "next dev --turbo",
    "serve-with-scheduler": "cross-env APP_SCHEDULER_ENABLED=1 next dev --turbo",
    "lint": "biome check",
    "lint:fix": "biome lint --write",
    "test": "cross-env NODE_OPTIONS=--no-webstorage vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--no-webstorage vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnimeNL/volunteer-manager.git"
  },
  "author": "Peter Beverloo <peter@animecon.nl>",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/AnimeNL/volunteer-manager",
  "engines": {
    "node": ">=26.0.0"
  },
  "overrides": {
    "@mui/material": "$@mui/material",
    "nodemailer-mock": {
      "nodemailer": "$nodemailer"
    },
    "ts-sql-codegen": {
      "ts-sql-query": "$ts-sql-query"
    }
  },
  "dependencies": {
    "@AnimeNL/volunteer-manager-timeline": "git+https://git@github.com/AnimeNL/volunteer-manager-timeline.git#3.1.2",
    "@google/genai": "^2.32.0",
    "@mdxeditor/editor": "^4.3.4",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@mui/x-charts-premium": "^9.17.0",
    "@mui/x-data-grid-premium": "^9.17.0",
    "@mui/x-date-pickers": "^9.17.0",
    "@mui/x-license": "^9.17.0",
    "@mui/x-scheduler-premium": "^9.0.0-beta.15",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "bowser": "^2.15.0",
    "cookie": "^2.0.1",
    "d3-color": "^3.1.0",
    "d3-interpolate": "^3.0.1",
    "dayjs": "^1.11.23",
    "mariadb": "^3.5.4",
    "mui-color-input": "^9.0.0",
    "mui-markdown": "^3.0.1",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "nuqs": "^2.10.2",
    "qrcode-with-logos": "^1.2.1",
    "react": "^19.3.1",
    "react-avatar-editor": "16.0.0",
    "react-dom": "^19.3.1",
    "react-hook-form-mui": "^9.0.1",
    "rehype-react": "^8.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "swr": "^2.5.1",
    "temporal-polyfill": "^1.0.6",
    "ts-sql-query": "2.0.0-beta.2",
    "twilio": "^6.2.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@next/bundle-analyzer": "16.4.3",
    "@simplewebauthn/typescript-types": "^8.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3": "^7.4.3",
    "@types/d3-color": "^3.1.3",
    "@types/d3-interpolate": "^3.0.4",
    "@types/node": "26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-avatar-editor": "^13.0.4",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.3",
    "nodemailer-mock": "^2.2.0",
    "ts-sql-codegen": "^3.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
